# --- ALDI TALK login (required) ---------------------------------------------
# Use single quotes so special characters (like $) are taken literally.
ALDI_PHONE='01xxxxxxxxx'
ALDI_PASSWORD='your-portal-password'

# --- Telegram (optional, recommended) ----------------------------------------
# Token from @BotFather. Chat id: send /start to your bot, then run
#   uv run python -m alditalk telegram-chat-id
TELEGRAM_TOKEN=''
TELEGRAM_CHAT_ID=''

# --- Dead-man's switch (optional) ---------------------------------------------
# Free check at https://healthchecks.io. It alerts you when pings stop.
HEALTHCHECK_URL=''

# --- Behaviour (defaults are fine) --------------------------------------------
# DRY_RUN=false            # true = never click, only log what it would do
# HEADLESS=false           # false = real window (under Xvfb in Docker)
# BROWSER_CHANNEL=chrome   # chrome | chromium
# THRESHOLD_MB=1024
# HARD_REFRESH=true        # Ctrl+Shift+R each check (~1.2 MB); false = normal reload (~30 KB). Data is always verified fresh
# KEEP_SESSION_ALIVE=true  # cap daytime gaps at 11–16 min so the portal (≈20 min idle logout) stays logged in
# QUIET_START_HOUR=1
# QUIET_END_HOUR=7
# MAX_CLAIMS_PER_HOUR=5
# DAILY_SUMMARY_HOUR=9
